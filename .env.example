DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/industrial
CHECKPOINTER_DSN=postgresql://agent:agent@localhost:5432/industrial

# Local Ollama defaults
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.0

EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_API_KEY=ollama
EMBEDDINGS_BASE_URL=http://localhost:11434/v1

COLLECTION_NAME=industrial_manuals
RAG_K=5

# For Docker Compose, app service overrides these to http://ollama:11434/v1 internally.
